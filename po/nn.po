#. TRANSLATORS: ascli flag description for: --profile
#: tools/appstreamcli.c:100
msgid "Enable profiling"
msgstr "Slå på profilering"

#. TRANSLATORS: ascli flag description for: --cachepath
#: tools/appstreamcli.c:121
msgid "Manually selected location of AppStream cache."
msgstr "Manuelt vald plassering for AppStream-mellomlageret."

#. TRANSLATORS: ascli flag description for: --datapath
#: tools/appstreamcli.c:127
msgid "Manually selected location of AppStream metadata to scan."
msgstr "Manuell plassering av AppStream-metadata som skal skannast."

#. TRANSLATORS: ascli flag description for: --no-cache
#: tools/appstreamcli.c:133
msgid "Ignore cache age and build a fresh cache before performing the query."
msgstr "Sjå bort frå alderen på mellomlageret og bygg eit nytt mellomlager før spørjinga vert utført."

#. TRANSLATORS: ascli flag description for: --format
#: tools/appstreamcli.c:149
msgid "Default metadata format (valid values are 'xml' and 'yaml')."
msgstr "Standard metadataformat (gyldige verdiar er 'xml' og 'yaml')."

#. TRANSLATORS: ascli flag description for: --details
#: tools/appstreamcli.c:165
msgid "Print detailed output about found components."
msgstr "Skriv ut detaljerte utdata om komponentane som vart funne."

#. TRANSLATORS: ascli flag description for: --server (used by the "list-reviews" command)
#: tools/appstreamcli.c:184
msgid "URL of the ODRS-compatible reviews server to use."
msgstr "URL til den ODRS-kompatible vurderingstenaren som skal brukast."

#. TRANSLATORS: ascli flag description for: --start (used by the "list-reviews" command)
#: tools/appstreamcli.c:190
msgid "Index of the first review to fetch, to page through all reviews."
msgstr "Indeks for den første vurderinga som skal hentast, for å bla gjennom alle vurderingane."

#. TRANSLATORS: ascli flag description for: --limit (used by the "list-reviews" command)
#: tools/appstreamcli.c:196
msgid "Maximum number of reviews to fetch."
msgstr "Høgaste tal på vurderingar som skal hentast."

#. TRANSLATORS: ascli flag description for: --locale (used by the "list-reviews" and "submit-review" commands)
#: tools/appstreamcli.c:202
msgid "Locale to prefer for reviews, instead of the current system locale."
msgstr "Lokalitet som skal føretrekkjast for vurderingar, i staden for lokaliteten til systemet."

#. TRANSLATORS: ascli flag description for: --pedantic (used by the "validate" command)
#: tools/appstreamcli.c:223
msgid "Also show pedantic hints."
msgstr "Vis òg pedantiske hint."

#. TRANSLATORS: ascli flag description for: --explain (used by the "validate" command)
#: tools/appstreamcli.c:230
msgid "Print detailed explanation for found issues."
msgstr "Skriv ut ei detaljert forklaring på problema som vart funne."

#. TRANSLATORS: ascli flag description for: --no-net (used by the "validate" command)
#: tools/appstreamcli.c:237
msgid "Do not use network access."
msgstr "Ikkje bruk nettverkstilgang."

#. TRANSLATORS: ascli flag description for: --strict (used by the "validate" command)
#: tools/appstreamcli.c:244
msgid "Fail validation if any issue is emitted that is not of pedantic severity."
msgstr "La valideringa mislukkast dersom det kjem eit problem som ikkje har alvorsgraden pedantisk."

#. TRANSLATORS: ascli flag description for: --format  when validating XML files
#: tools/appstreamcli.c:250
msgid "Format of the generated report (valid values are 'text' and 'yaml')."
msgstr "Formatet på den genererte rapporten (gyldige verdiar er 'text' og 'yaml')."

#. TRANSLATORS: ascli flag description for: --override  when validating XML files
#: tools/appstreamcli.c:256
msgid "Override the severities of selected issue tags."
msgstr "Overstyr alvorsgraden for utvalde problem-taggar."

#. TRANSLATORS: this is a (usually shorter) command alias, shown after the command summary text
#: tools/appstreamcli.c:303
#, c-format
msgid "(Alias: '%s')"
msgstr "(Alias: '%s')"

