#. TRANSLATORS: This is the header to the --help menu
#: tools/appstreamcli.c:352 tools/appstreamcli.c:1432
msgid "AppStream command-line interface"
msgstr "Kommandolinjegrensesnitt for AppStream"

#: tools/appstreamcli.c:355
#, c-format
msgid "'%s' command"
msgstr "Kommandoen «%s»"

#. TRANSLATORS: An unknown option was passed to appstreamcli.
#: tools/appstreamcli.c:398
#, c-format
msgid "Option '%s' is unknown."
msgstr "Valet '%s' er ukjent."

#: tools/appstreamcli.c:403 tools/appstreamcli.c:1810
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr "Køyr '%s --help' for å sjå ei fullstendig liste over tilgjengelege kommandolinjeval."

#: tools/appstreamcli.c:407
#, c-format
msgid "Run '%s --help' to see a list of available commands and options, and '%s %s --help' to see a list of options specific for this subcommand."
msgstr "Køyr '%s --help' for å sjå ei liste over tilgjengelege kommandoar og val, og '%s %s --help' for å sjå ei liste over val som gjeld for denne underkommandoen."

#. TRANSLATORS: ascli flag description for: --force
#: tools/appstreamcli.c:462
msgid "Enforce a cache refresh."
msgstr "Tving fram oppfrisking av mellomlageret."

#. TRANSLATORS: ascli flag description for: --source in a refresh action. Don't translate strings in backticks: `name`
#: tools/appstreamcli.c:468
msgid "Limit cache refresh to data from a specific source, e.g. `os` or `flatpak`. May be specified multiple times."
msgstr "Avgrens oppfriskinga av mellomlageret til data frå ei bestemt kjelde, t.d. `os` eller `flatpak`. Kan oppgjevast fleire gonger."

#. TRANSLATORS: ascli check-license is missing its parameter
#: tools/appstreamcli.c:726
msgid "No license, license expression or license exception string was provided."
msgstr "Ingen lisens, lisensuttrykk eller lisensunntak vart oppgjeve."

#. TRANSLATORS: ascli flag description for: --details (part of the "check-syscompat" subcommand)
#: tools/appstreamcli.c:775
msgid "Print more detailed output on why incompatibilities exist."
msgstr "Skriv ut meir detaljerte utdata om kvifor det finst inkompatibilitetar."

#. TRANSLATORS: ascli flag description for: --origin (part of the "put" subcommand)
#: tools/appstreamcli.c:812
msgid "Set the data origin for the installed metadata catalog file."
msgstr "Set opphavet til den installerte katalogfila for metadata."

#. TRANSLATORS: ascli flag description for: --user (part of the "put" subcommand)
#: tools/appstreamcli.c:818
msgid "Install the file for the current user, instead of globally."
msgstr "Installer fila for den noverande brukaren, i staden for globalt."

#. TRANSLATORS: ascli flag description for: --bundle-type (part of the "remove" and "install" subcommands)
#: tools/appstreamcli.c:846
msgid "Limit the command to use only components from the given bundling system (`flatpak` or `package`)."
msgstr "Avgrens kommandoen til berre å bruke komponentar frå det oppgjevne pakkesystemet (`flatpak` eller `package`)."

#. TRANSLATORS: ascli flag description for: --first (part of the "remove" and "install" subcommands)
#: tools/appstreamcli.c:853
msgid "Do not ask for which software component should be used and always choose the first entry."
msgstr "Ikkje spør kva programvarekomponent som skal brukast, og vel alltid den første oppføringa."

#. TRANSLATORS: ascli install currently only supports two values for --bundle-type.
#: tools/appstreamcli.c:887 tools/appstreamcli.c:922
msgid "No valid bundle kind was specified. Only `package` and `flatpak` are currently recognized."
msgstr "Ingen gyldig pakketype vart oppgjeven. Førebels er berre `package` og `flatpak` kjende."

#: tools/appstreamcli.c:1082
msgid "You need to provide at least two version numbers to compare as parameters."
msgstr "Du må oppgje minst to versjonsnummer som parametrar for å samanlikne."

#. * TRANSLATORS: The user tried to compare version numbers, but the comparison operator (greater-then, equal, etc.) was invalid.
#: tools/appstreamcli.c:1111
#, c-format
msgid "Unknown compare relation '%s'. Valid values are:"
msgstr "Ukjend samanlikningsrelasjon «%s». Gyldige verdiar er:"

#: tools/appstreamcli.c:1152
msgid "Too many parameters: Need two version numbers or version numbers and a comparison operator."
msgstr "For mange parametrar: Treng to versjonsnummer, eller versjonsnummer og ein samanlikningsoperator."

#. TRANSLATORS: ascli flag description for: --from-desktop (part of the new-template subcommand)
#: tools/appstreamcli.c:1178
msgid "Use the given .desktop file to fill in the basic values of the metainfo file."
msgstr "Bruk den oppgjevne .desktop-fila til å fylle inn dei grunnleggjande verdiane i metainfo-fila."

#. TRANSLATORS: Additional help text for the 'new-template' ascli subcommand
#: tools/appstreamcli.c:1186
msgid "This command takes optional TYPE and FILE positional arguments, FILE being a file to write to (or \"-\" for standard output)."
msgstr "Denne kommandoen tek dei valfrie posisjonsargumenta TYPE og FILE, der FILE er ei fil det skal skrivast til (eller «-» for standard ut)."

#. TRANSLATORS: Additional help text for the 'new-template' ascli subcommand, a bullet-pointed list of types follows
#: tools/appstreamcli.c:1191
#, c-format
msgid "The TYPE must be a valid component-type, such as: %s"
