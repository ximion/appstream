#: tools/appstreamcli.c:156
msgid "Default metadata format (valid values are 'xml' and 'yaml')."
msgstr "Forvalgt metadataformat (gyldige verdier er \"xml\" og \"yaml\")."

#. TRANSLATORS: ascli flag description for: --details
#: tools/appstreamcli.c:172
msgid "Print detailed output about found components."
msgstr "Skriv detaljert utdata om identifiserte komponenter."

#. TRANSLATORS: ascli flag description for: --server (used by the "list-reviews" command)
#: tools/appstreamcli.c:191
msgid "URL of the ODRS-compatible reviews server to use."
msgstr "URL til den ODRS-kompatible vurderingstjeneren som skal brukes."

#. TRANSLATORS: ascli flag description for: --start (used by the "list-reviews" command)
#: tools/appstreamcli.c:197
msgid "Index of the first review to fetch, to page through all reviews."
msgstr "Indeks for den første vurderingen som skal hentes, for å bla gjennom alle vurderingene."

#. TRANSLATORS: ascli flag description for: --limit (used by the "list-reviews" command)
#: tools/appstreamcli.c:203
msgid "Maximum number of reviews to fetch."
msgstr "Maksimalt antall vurderinger som skal hentes."

#. TRANSLATORS: ascli flag description for: --locale (used by the "list-reviews" and "submit-review" commands)
#: tools/appstreamcli.c:209
msgid "Locale to prefer for reviews, instead of the current system locale."
msgstr "Lokalitet som skal foretrekkes for vurderinger, i stedet for den nåværende systemlokaliteten."

#. TRANSLATORS: ascli flag description for: --pedantic (used by the "validate" command)
#: tools/appstreamcli.c:230
msgid "Also show pedantic hints."
msgstr "Vis også pedantiske tips."

#. TRANSLATORS: ascli flag description for: --explain (used by the "validate" command)
#: tools/appstreamcli.c:237
msgid "Print detailed explanation for found issues."
msgstr "Skriv ut en detaljert forklaring av problemene som ble funnet."

#. TRANSLATORS: ascli flag description for: --no-net (used by the "validate" command)
#: tools/appstreamcli.c:244
msgid "Do not use network access."
msgstr "Ikke bruk nettverkstilgang."

#. TRANSLATORS: ascli flag description for: --strict (used by the "validate" command)
#: tools/appstreamcli.c:251
msgid "Fail validation if any issue is emitted that is not of pedantic severity."
msgstr "La valideringen mislykkes dersom det utstedes et problem som ikke har alvorlighetsgraden pedantisk."

#. TRANSLATORS: ascli flag description for: --format  when validating XML files
#: tools/appstreamcli.c:257
msgid "Format of the generated report (valid values are 'text' and 'yaml')."
msgstr "Formatet på den genererte rapporten (gyldige verdier er 'text' og 'yaml')."

#. TRANSLATORS: ascli flag description for: --override  when validating XML files
#: tools/appstreamcli.c:263
msgid "Override the severities of selected issue tags."
msgstr "Overstyr alvorlighetsgraden for utvalgte problemtagger."

