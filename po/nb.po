#. TRANSLATORS: An invalid XML element was found, "Found" refers to the tag name found, "Allowed" to the permitted names.
#: src/as-validator.c:897 src/as-validator.c:1673 src/as-validator.c:1849
#: src/as-validator.c:2070 src/as-validator.c:2735 src/as-validator.c:2757
#: src/as-validator.c:2882 src/as-validator.c:3206
#, c-format
msgid "Found: %s - Allowed: %s"
msgstr "Funnet: %s - Tillatt: %s"

#. TRANSLATORS: ascli flag description for: --verbose
#. TRANSLATORS: ascompose flag description for: --verbose
#: tools/appstream-compose.c:187 tools/appstreamcli.c:88
msgid "Show extra debugging information."
msgstr "Vis ekstra feilrettingsinformasjon."

#. TRANSLATORS: ascli flag description for: --no-color
#. TRANSLATORS: ascompose flag description for: --no-color
#: tools/appstream-compose.c:194 tools/appstreamcli.c:94
msgid "Don't show colored output."
msgstr "Ikke vis fargelagt utdata."

#. TRANSLATORS: ascli flag description for: --version
#. TRANSLATORS: ascompose flag description for: --version
#: tools/appstream-compose.c:201 tools/appstreamcli.c:82
msgid "Show the program version."
msgstr "Vis programversjonen."

#. TRANSLATORS: ascompose flag description for: --no-net
#: tools/appstream-compose.c:208
msgid "Do not use the network at all, not even for URL validity checks."
msgstr "Bruk ikke nettverket i det hele tatt, ikke en gang for å kontrollere om URL-er er gyldige."

#. TRANSLATORS: ascompose flag description for: --print-report
#: tools/appstream-compose.c:215
msgid "Set mode of the issue report that is printed to the console."
msgstr "Angi modus for problemrapporten som skrives ut i konsollen."

#. TRANSLATORS: ascompose flag description for: --prefix
#: tools/appstream-compose.c:222
msgid "Override the default prefix (`/usr` by default)."
msgstr "Overstyr standardprefikset (`/usr` som standard)."

#. TRANSLATORS: ascompose flag description for: --result-root
#: tools/appstream-compose.c:229
msgid "Set the result output directory."
msgstr "Angi utdatamappen for resultatet."

#. TRANSLATORS: ascompose flag description for: --data-dir, `catalog metadata` is an AppStream term
#: tools/appstream-compose.c:236
msgid "Override the catalog metadata output directory."
msgstr "Overstyr utdatamappa for katalogmetadata."

#. TRANSLATORS: ascompose flag description for: --icons-dir
#: tools/appstream-compose.c:243
msgid "Override the icon output directory."
msgstr "Overstyr utdata-mappen for ikoner."

#. TRANSLATORS: ascompose flag description for: --media-dir
#: tools/appstream-compose.c:250
msgid "Set the media output directory (for media data to be served by a webserver)."
msgstr "Angi utdatamappen for media (for mediedata som skal leveres av en webserver)."

#. TRANSLATORS: ascompose flag description for: --hints-dir
#: tools/appstream-compose.c:257
msgid "Set a directory where HTML and text issue reports will be stored."
msgstr "Angi en mappe der HTML- og tekstproblemrapporter vil bli lagret."

#. TRANSLATORS: ascompose flag description for: --origin
#: tools/appstream-compose.c:264
msgid "Set the origin name"
msgstr "Sett opphavsnavnet"

#. TRANSLATORS: ascompose flag description for: --media-baseurl
#: tools/appstream-compose.c:271
msgid "Set the URL where the exported media content will be hosted."
msgstr "Angi URL-en der det eksporterte medieinnholdet skal ligge."

#. TRANSLATORS: ascompose flag description for: --no-partial-urls
#: tools/appstream-compose.c:278
msgid "Makes all URLs in output data complete URLs and avoids the use of a shared URL prefix for all metadata."
msgstr "Gjør alle URL-er i utdataene til fullstendige URL-er og unngår bruken av et felles URL-prefiks for all metadata."

#. TRANSLATORS: ascompose flag description for: --icon-policy
#: tools/appstream-compose.c:285
msgid "An icon-policy string to set how icon sizes should be handled (refer to the man page for details)."
msgstr "En streng for ikonpolicy som fastsetter hvordan ikonstørrelser skal håndteres (se manualsiden for detaljer)."

#. TRANSLATORS: ascompose flag description for: --image-format
#: tools/appstream-compose.c:292
msgid "The file format that generated icons and screenshots are stored in (`jxl` by default, or `png` for compatibility with older clients)."
msgstr "Filformatet som genererte ikoner og skjermbilder lagres i (`jxl` som standard, eller `png` for kompatibilitet med eldre klienter)."

#. TRANSLATORS: ascompose flag description for: --allow-custom
#: tools/appstream-compose.c:299
msgid "A comma-separated list of custom keys that should be propagated to the output data."
msgstr "En komma-separert liste over egne nøkler som skal føres videre til utdataene."

#. TRANSLATORS: ascompose flag description for: --components
#: tools/appstream-compose.c:306
msgid "A comma-separated list of component-IDs to accept."
msgstr "En kommaseparert liste over komponent-ID-er som skal godtas."

#. TRANSLATORS: Error message of appstream-compose
#: tools/appstream-compose.c:323
msgid "Failed to parse arguments"
msgstr "Kunne ikke tolke argumentene"

#. TRANSLATORS: Output if appstreamcli --version is executed.
#: tools/appstream-compose.c:334 tools/appstreamcli.c:1831
#, c-format
msgid "AppStream version: %s"
msgstr "AppStream-versjon: %s"

#. TRANSLATORS: Output if appstreamcli --version is run and the CLI and libappstream versions differ.
#: tools/appstream-compose.c:338 tools/appstreamcli.c:1835
#, c-format
msgid ""
"AppStream CLI tool version: %s\n"
"AppStream library version: %s"
msgstr ""
"Versjon av kommandolinjegrensesnitt for AppStream: %s\n"
"Versjon av AppStream-bibliotek: %s"

#. TRANSLATORS: invalid value for the --print-report CLI option
#: tools/appstream-compose.c:360
#, c-format
msgid ""
"Invalid value for `--print-report` option: %s\n"
"Possible values are:\n"
"`on-error` - only prints a short report if the run failed (default)\n"
"`short` - generates an abridged report\n"
"`full` - a detailed report will be printed"
msgstr ""
"Ugyldig verdi for `--print-report`-valget: %s\n"
"Mulige verdier er:\n"
"`on-error` - skriver bare en kort rapport hvis kjøringen feilet (standard)\n"
"`short` - lager en forkortet rapport\n"
"`full` - en detaljert rapport vil bli skrevet ut"

